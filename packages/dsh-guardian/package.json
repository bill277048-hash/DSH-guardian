{
  "name": "@botton/dsh-guardian",
  "description": "dsh-guardian 守护程序面板插件：在 dsh WebUI 中启动/停止/查看 guardian 双 LaunchAgent，全部为既有 launchctl 启停逻辑的封装，零第三方运行时依赖。",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bill277048-hash/DSH-guardian.git"
  },
  "homepage": "https://github.com/bill277048-hash/DSH-guardian#readme",
  "bugs": {
    "url": "https://github.com/bill277048-hash/DSH-guardian/issues"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "screenshots.json",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "launchd",
    "launchctl",
    "guardian",
    "macos",
    "deepseek-harness"
  ],
  "author": "botton指北",
  "license": "MIT"
}
